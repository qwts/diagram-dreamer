{
  "name": "vellum",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "pnpm --filter @vellum/renderer dev",
    "build": "pnpm --filter @vellum/renderer build",
    "build:pseudo": "pnpm --filter @vellum/renderer build:pseudo",
    "preview": "pnpm --filter @vellum/renderer preview",
    "test": "pnpm --filter @vellum/renderer test",
    "test:a11y": "pnpm --filter @vellum/renderer test:a11y",
    "check:contrast": "pnpm --filter @vellum/renderer check:contrast",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run check:contrast && pnpm run build && pnpm run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "prettier": "^3.7.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1"
  }
}
