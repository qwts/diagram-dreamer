{
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*.ts"],
  "compilerOptions": {
    // DOM, because `src/render` drives an iframe and Mermaid needs a document.
    // Framework-agnostic (SPEC §4) was never the same claim as platform-
    // agnostic: this package targets a browser, it just does not target React.
    "lib": ["ES2022", "DOM"],
    // For reading Mermaid's own version out of its package.json rather than
    // restating it here.
    "resolveJsonModule": true
  }
}
